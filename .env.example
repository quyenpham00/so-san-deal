# Copy to .env and fill in.
PORT=3000

# Address to listen on. Leave empty for all; 127.0.0.1 when a reverse proxy (Caddy) is on the same machine.
# HOST=127.0.0.1

# Password for /admin. Required to enable the admin page.
ADMIN_PASSWORD=change-me

# Long random string used to sign the admin login cookie.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# SQLite database file (created on first start).
DB_PATH=data/so-san-deal.db

# Where product / gift pictures cut out of imported files are kept (default: "images" next to the database).
# IMAGES_DIR=data/images

# Set to 1 when the site is served over HTTPS (adds Secure to the login cookie).
COOKIE_SECURE=0

# Largest deal-list file an admin can upload, in MB.
MAX_UPLOAD_MB=40

# How many different networks must report the same price before it shows as the deal's price.
CONFIRM_VOTES=2

# Client IPs (used for vote counting and rate limits) are read from X-Forwarded-For only when the
# request comes from a trusted proxy. Default "loopback" = a reverse proxy on this machine.
# Behind a hosting platform's proxy use 1 (one hop) or the proxy's subnet.
TRUST_PROXY=loopback
